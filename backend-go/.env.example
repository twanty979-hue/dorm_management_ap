# ==============================================================================
# 🔑 SUPABASE DATABASE PASSWORD
# ==============================================================================
DB_PASSWORD=your_supabase_db_password

PORT=8080
ENV=development

# Supabase Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# PostgreSQL Connection String (Pooler & Direct)
DATABASE_URL=postgres://postgres.your-project:your_password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# JWT Secret
JWT_SECRET=your_jwt_secret_key
